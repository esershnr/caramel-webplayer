{
  "name": "@esershnr/caramel-skin",
  "version": "0.2.0",
  "description": "Video.js 10 video skin with Lucide morphing icons, theme tokens, quality badge, seek indicator and preview card",
  "keywords": [
    "videojs",
    "video.js",
    "videojs-10",
    "video-player",
    "web-components",
    "custom-elements",
    "skin",
    "video-skin",
    "hls",
    "thumbnails",
    "react"
  ],
  "license": "MIT AND Apache-2.0",
  "author": "Eser Şahiner (https://esersahiner.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esershnr/caramel-webplayer.git",
    "directory": "packages/skin"
  },
  "homepage": "https://github.com/esershnr/caramel-webplayer/tree/main/packages/skin#readme",
  "bugs": {
    "url": "https://github.com/esershnr/caramel-webplayer/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/define.js",
    "./src/define.ts",
    "./dist/components/videojs/video/skin.js",
    "./src/components/videojs/video/skin.ts"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "caramel-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "caramel-source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./react": {
      "caramel-source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./skin.css": {
      "caramel-source": "./src/styles/skin.css",
      "default": "./dist/styles/skin.css"
    },
    "./all.css": {
      "caramel-source": "./src/styles/all.css",
      "default": "./dist/styles/all.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:template": "node --conditions=caramel-source --import tsx scripts/build-template.ts",
    "build": "pnpm run build:template && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@esershnr/caramel-icons": "workspace:*",
    "@esershnr/caramel-theme": "workspace:*"
  },
  "peerDependencies": {
    "@videojs/html": "10.0.x",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/react": "^19.1.0",
    "@videojs/html": "10.0.1",
    "react": "^19.2.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
