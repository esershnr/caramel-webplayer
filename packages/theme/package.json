{
  "name": "@esershnr/caramel-theme",
  "version": "0.1.0",
  "description": "Design tokens (--caramel-*) for Caramel Webplayer (Video.js 10): light/dark palette, segment colors, motion, typography, presets",
  "keywords": [
    "videojs",
    "video.js",
    "videojs-10",
    "video-player",
    "web-components",
    "custom-elements",
    "design-tokens",
    "css-variables",
    "theme",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "Eser Şahiner (https://esersahiner.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esershnr/caramel-webplayer.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/esershnr/caramel-webplayer/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/esershnr/caramel-webplayer/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles",
    "presets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "caramel-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./fonts.css": "./styles/fonts.css",
    "./package.json": "./package.json",
    "./presets/*.css": "./presets/*.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
