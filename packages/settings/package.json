{
  "name": "@esershnr/caramel-settings",
  "version": "0.0.0",
  "description": "Settings panel for the Caramel Webplayer: subtitle style, player preferences and display options, remembered across visits",
  "keywords": [
    "videojs",
    "video.js",
    "videojs-10",
    "video-player",
    "web-components",
    "custom-elements",
    "settings",
    "preferences",
    "subtitles",
    "captions",
    "react"
  ],
  "license": "MIT",
  "author": "Eser Şahiner (https://esersahiner.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esershnr/caramel-webplayer.git",
    "directory": "packages/settings"
  },
  "homepage": "https://github.com/esershnr/caramel-webplayer/tree/main/packages/settings#readme",
  "bugs": {
    "url": "https://github.com/esershnr/caramel-webplayer/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/define.js",
    "./src/define.ts"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "caramel-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "caramel-source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./react": {
      "caramel-source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./settings.css": {
      "caramel-source": "./src/styles/settings.css",
      "default": "./dist/styles/settings.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/styles','dist/styles',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@esershnr/caramel-icons": "workspace:*",
    "@esershnr/caramel-theme": "workspace:*"
  },
  "peerDependencies": {
    "@videojs/html": "10.0.x",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@videojs/html": "10.1.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
