{
  "name": "@esershnr/caramel-webplayer",
  "version": "0.2.1",
  "description": "Caramel Webplayer: a themed Video.js 10 player in one package (skin, skip segments, chapters, playlist, icons, theme)",
  "keywords": [
    "videojs",
    "video.js",
    "videojs-10",
    "video-player",
    "web-components",
    "custom-elements",
    "skip-intro",
    "chapters",
    "playlist",
    "theme",
    "react"
  ],
  "license": "MIT",
  "author": "Eser Şahiner (https://esersahiner.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esershnr/caramel-webplayer.git",
    "directory": "packages/webplayer"
  },
  "homepage": "https://github.com/esershnr/caramel-webplayer/tree/main/packages/webplayer#readme",
  "bugs": {
    "url": "https://github.com/esershnr/caramel-webplayer/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/define.js",
    "./src/define.ts"
  ],
  "files": [
    "dist",
    "styles",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "caramel-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "caramel-source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./react": {
      "caramel-source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./webplayer.css": "./styles/webplayer.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@esershnr/caramel-chapters": "workspace:*",
    "@esershnr/caramel-icons": "workspace:*",
    "@esershnr/caramel-playlist": "workspace:*",
    "@esershnr/caramel-skin": "workspace:*",
    "@esershnr/caramel-skip-segments": "workspace:*",
    "@esershnr/caramel-theme": "workspace:*"
  },
  "peerDependencies": {
    "@videojs/html": "10.0.x",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@videojs/html": "10.0.1",
    "react": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
