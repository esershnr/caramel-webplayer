{
  "name": "@esershnr/caramel-icons",
  "version": "0.1.0",
  "description": "Lucide icon data and a morphing <esp-morph-icon> element for the esersahiner Video.js 10 player",
  "keywords": [
    "videojs",
    "video.js",
    "videojs-10",
    "video-player",
    "web-components",
    "custom-elements",
    "icons",
    "lucide",
    "morph",
    "animated-icons",
    "react"
  ],
  "license": "MIT",
  "author": "Eser Şahiner (https://esersahiner.com)",
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./src/define.ts"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "esp-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "esp-source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./react": {
      "esp-source": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "lucide": "^1.54.0",
    "morphicons": "^1.7.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
