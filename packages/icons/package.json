{
  "name": "@esersahiner/player-icons",
  "version": "0.1.0",
  "description": "Lucide icon data and a morphing icon element for the esersahiner web player",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./src/define.ts", "./dist/define.js"],
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "development": "./src/define.ts",
      "default": "./dist/define.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "development": "./src/react.tsx",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide": "^1.54.0",
    "morphicons": "^1.7.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
