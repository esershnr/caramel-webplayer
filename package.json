{
  "name": "esersahiner-webplayer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Custom Video.js 10 player packages for esersahiner.com",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './scripts/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vanilla": "pnpm --filter @esersahiner/example-vanilla dev",
    "dev:react": "pnpm --filter @esersahiner/example-react dev"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
