{
  "name": "caramel-webplayer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Custom Video.js 10 player packages for esersahiner.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esershnr/caramel-webplayer.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"@esershnr/caramel-*\" --filter \"@esershnr/caramel-gen-thumbs\" --filter \"@esershnr/caramel-encode-hls\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:vanilla": "pnpm --filter @esershnr/caramel-example-vanilla dev",
    "dev:react": "pnpm --filter @esershnr/caramel-example-react dev"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
