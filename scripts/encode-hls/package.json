{
  "name": "@esershnr/caramel-encode-hls",
  "version": "0.1.0",
  "private": true,
  "description": "Turn media/<slug> (source video, SRT subtitles, meta.yaml) into publish-ready HLS, poster, thumbnails, chapters, subtitles and a playlist manifest",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "caramel-encode-hls": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "caramel-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --conditions=caramel-source --import tsx src/cli.ts"
  },
  "dependencies": {
    "@esershnr/caramel-gen-thumbs": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
